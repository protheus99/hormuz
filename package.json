{
  "name": "hormuz",
  "version": "0.0.0",
  "private": true,
  "description": "Hormuz — an oil company strategy game on the GEMS market engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --watch --coverage --open=false",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "sim": "tsx src/cli/main.ts",
    "golden:browser": "vite tests/golden --port 5174 --strictPort",
    "scenario": "tsx tools/run-scenario.ts",
    "economics": "tsx tools/economics.ts",
    "calibrate": "tsx tools/calibrate.ts",
    "report": "tsx tools/report.ts",
    "campaign": "tsx tools/campaign.ts",
    "pacing": "tsx tools/pacing.ts",
    "credit": "tsx tools/credit.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.140.0"
  }
}
